{
  "name": "tt-carousel-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first TikTok carousel research, pattern mining, and production workspace.",
  "license": "MIT",
  "author": "Danik Pavlovski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danprog4/tt-carousels.git"
  },
  "homepage": "https://github.com/Danprog4/tt-carousels#readme",
  "bugs": {
    "url": "https://github.com/Danprog4/tt-carousels/issues"
  },
  "keywords": [
    "tiktok",
    "carousel",
    "content-research",
    "creator-research",
    "pinterest",
    "local-first"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "npm run typecheck && vite build",
    "start": "npm run build && npm run serve",
    "serve": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx src/server/seed-demo.ts",
    "chrome:start": "bash scripts/start-chrome.sh",
    "ai:login": "bash scripts/pi-login.sh",
    "pinterest:search": "tsx src/server/pinterest-cli.ts",
    "postinstall": "node scripts/patch-pi-dependencies.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.8",
    "@fontsource-variable/tiktok-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.2.0",
    "brace-expansion": "5.0.9",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "minimatch": "10.2.6",
    "playwright-core": "^1.54.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
